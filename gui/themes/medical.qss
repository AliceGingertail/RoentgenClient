/* Shell */
QWidget {
    color: #223744;
    selection-background-color: #c7ebe5;
    selection-color: #153e39;
}

QMainWindow, QDialog {
    background-color: #f5fafb;
}

QMainWindow::separator {
    background-color: #d6e4e8;
    width: 1px;
    height: 1px;
}

/* Menus and toolbar */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d6e4e8;
    padding: 4px 8px;
}

QMenuBar::item {
    background-color: transparent;
    border-radius: 4px;
    padding: 5px 12px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #e0f3ef;
    color: #175951;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #bdcfd5;
    padding: 5px;
}

QMenu::item {
    border-radius: 4px;
    padding: 7px 24px;
}

QMenu::item:selected {
    background-color: #e0f3ef;
    color: #175951;
}

QMenu::item:disabled, QLabel:disabled {
    color: #667b86;
}

QMenu::separator {
    background-color: #d6e4e8;
    height: 1px;
    margin: 4px 8px;
}

QToolBar {
    background-color: #f5fafb;
    border: 0;
    spacing: 6px;
}

/* Image workspace */
QTabWidget::pane {
    background-color: #e3e5e7;
    border: 1px solid #cbd9de;
}

QTabBar::tab {
    background-color: #ffffff;
    color: #4c6673;
    border: 1px solid #d6e4e8;
    border-bottom: 2px solid #d6e4e8;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
    padding: 7px 12px;
    min-width: 72px;
}

QTabBar::tab:hover {
    background-color: #eff8f6;
    color: #223744;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #174842;
    border-bottom-color: #168477;
}

QGraphicsView {
    background-color: #e3e5e7;
    border: 0;
}

QStatusBar {
    background-color: #ffffff;
    color: #4c6673;
    border-top: 1px solid #d6e4e8;
}

QStatusBar::item {
    border: 0;
}

QStatusBar QLabel {
    color: #17685e;
    padding: 3px 10px;
}

/* Dialog controls */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #afc6cb;
    border-radius: 6px;
    padding: 6px 14px;
    min-width: 56px;
}

QPushButton:hover {
    background-color: #eaf7f4;
    border-color: #539a91;
}

QPushButton:focus, QPushButton:default {
    border-color: #168477;
}

QPushButton:pressed {
    background-color: #d5eee9;
}

QPushButton:disabled {
    background-color: #edf2f3;
    color: #667b86;
    border-color: #d6e4e8;
}

QSlider::groove:horizontal {
    background-color: #c8d9dd;
    border-radius: 3px;
    height: 6px;
}

QSlider::sub-page:horizontal {
    background-color: #67b8ac;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #187f73;
    border: 1px solid #116e63;
    border-radius: 7px;
    width: 12px;
    margin: -4px 0;
}

QSlider::handle:horizontal:hover, QSlider::handle:horizontal:focus {
    background-color: #116e63;
}

/* Qt file picker */
QFileDialog QLineEdit, QFileDialog QComboBox, QFileDialog QAbstractItemView {
    background-color: #ffffff;
    alternate-background-color: #f4f8f9;
    border: 1px solid #bdcfd5;
    border-radius: 4px;
}

QFileDialog QLineEdit, QFileDialog QComboBox {
    padding: 5px 8px;
}

QFileDialog QLineEdit:focus, QFileDialog QComboBox:focus {
    border-color: #168477;
}

QFileDialog QHeaderView::section {
    background-color: #ffffff;
    color: #4c6673;
    border: 0;
    border-right: 1px solid #bdcfd5;
    padding: 5px;
}

QToolTip {
    background-color: #ffffff;
    color: #223744;
    border: 1px solid #afc6cb;
    padding: 4px;
}
